SECRET_KEY=put-a-long-random-string-here
DATABASE_URL=sqlite:///./app.db        # production: postgresql://user:pass@host/db
ADMIN_EMAIL=you@example.com            # register with this email -> becomes admin
JAZZCASH_NUMBER=03XXXXXXXXX
EASYPAISA_NUMBER=03XXXXXXXXX
PAY_ACCOUNT_NAME=Your Name
GOOGLE_CLIENT_ID=                      # optional: enables Google one-tap login
ATTEMPTS_PER_ENTRY=3
GAME_SECONDS=20
DRAW_MODE=random                       # random = lucky draw in Top 20 | top = rank #1 wins (skill only)
AUTO_APPROVE_PAYMENTS=false            # true ONLY for local testing
COMPANY_NAME=JeetoPrizes               # shown on Terms / Privacy pages
CONTACT_EMAIL=support@yourdomain.com   # shown on legal pages
WHATSAPP_NUMBER=923XXXXXXXXX           # support button in the app (country code, no +)
