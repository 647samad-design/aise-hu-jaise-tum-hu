# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where users send their top-up money (shown on the Wallet page)
NEXT_PUBLIC_PAY_ACCOUNT_NAME=Your Name
NEXT_PUBLIC_PAY_EASYPAISA=03XXXXXXXXX
NEXT_PUBLIC_PAY_JAZZCASH=03XXXXXXXXX

# Minimum wallet top-up in PKR
NEXT_PUBLIC_MIN_TOPUP=50

# Optional: WhatsApp support number shown in the footer (international format, e.g. 923001234567)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Payment QR ("scanner"). Easiest: upload it in /admin → Payment settings (no env needed).
# Or put the image in /public and set e.g. /payment-qr.png here as a fallback.
NEXT_PUBLIC_PAY_QR_URL=

# Emails (approval emails + "email all participants" button) — sent from your own Gmail.
# Server-only: never NEXT_PUBLIC_. EMAIL_HOST_PASSWORD is a Google *App Password*:
# Google Account → Security → 2-Step Verification ON → App passwords → create "1Rupya" → copy the 16 letters.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=1Rupya <you@gmail.com>

# Google sign-in: the Client ID / Client Secret do NOT go here. Paste them in
# Supabase → Authentication → Sign In / Providers → Google (see README).

# SEO: Google Search Console verification code (the content="..." value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Android app (optional). After you build an APK with PWABuilder (see README), set:
NEXT_PUBLIC_ANDROID_APK_URL=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINT=
