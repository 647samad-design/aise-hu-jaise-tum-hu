# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where users send their top-up money (shown on the Wallet page)
NEXT_PUBLIC_PAY_ACCOUNT_NAME=Your Name
NEXT_PUBLIC_PAY_EASYPAISA=03XXXXXXXXX
NEXT_PUBLIC_PAY_JAZZCASH=03XXXXXXXXX

# Minimum wallet top-up in PKR
NEXT_PUBLIC_MIN_TOPUP=50
